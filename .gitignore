.DS_Store
_homebrew/Brewfile.snapshot
btop/.config/btop/btop.log
__pycache__

# neovim/package manager artifacts
neovim/.config/nvim/.netrwhist
nvim.log

# GnuPG runtime/private material. Keep only the reviewed public configuration
# files tracked even if ~/.gnupg is accidentally folded into the Stow package.
gnupg/.gnupg/*
!gnupg/.gnupg/gpg-agent.conf
!gnupg/.gnupg/gpg.conf
!gnupg/.gnupg/scdaemon.conf

# neovim/Obsession artifacts
Session.vim

# tmux resurrect artifacts
tmux/.tmux/resurrect/*
tmux/.tmux/plugins/*

# nnn
nnn/.config/nnn/plugins/*
nnn/.config/nnn/.lastd
nnn/.config/nnn/**/*.tar.gz
nnn/.config/nnn/sessions/*
nnn/.config/nnn/nnn-*

# Lua rc for neovim setup
neovim/.config/nvim/lua/.luarc.json

# work-related snippets
neovim/.config/nvim/lua/snippets/work.lua

# pi auth/session state (never commit)
pi/.pi/agent/auth.json
pi/.pi/agent/sessions/
