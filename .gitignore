# neovim/package manager artifacts
neovim/.config/nvim/.netrwhist
nvim.log

# GnuPG runtime/private material. Keep only the reviewed public configuration
# files tracked even if ~/.gnupg is accidentally folded into the Stow package.
gnupg/.gnupg/*
!gnupg/.gnupg/gpg-agent.conf
!gnupg/.gnupg/gpg.conf
!gnupg/.gnupg/scdaemon.conf

# neovim/Obsession artifacts
Session.vim

# tmux resurrect artifacts
tmux/.tmux/resurrect/*
tmux/.tmux/plugins/*

# nnn
